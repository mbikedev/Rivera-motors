# Copy to .env.local for local development. Never commit real values.
# Without the two Supabase variables the site runs on clearly labelled FICTIONAL demo data.

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "anon" / "publishable" key – safe for the browser, access is limited by Row Level Security
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of the site (canonical URLs, hreflang, sitemap). On Netlify, URL is used as a fallback.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Set to "true" in production so a missing Supabase configuration fails the build
# instead of silently showing demo data.
REQUIRE_SUPABASE=false

# NOT used by the application. Keep the service-role key out of Netlify unless you add
# a server-only job that really needs it – it bypasses Row Level Security.
# SUPABASE_SERVICE_ROLE_KEY=
